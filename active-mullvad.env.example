# active-mullvad.env.example
#
# Copy this file to active-mullvad.env (same directory as
# docker-compose.yml) and fill in your own values. active-mullvad.env

# Your Mullvad WireGuard private key.
# Get this from your Mullvad account page -> WireGuard configuration
# -> Generate key. Copy the "PrivateKey" value from the generated
# config.
WIREGUARD_PRIVATE_KEY=your_wireguard_private_key_here

# The "Address" value from that same generated WireGuard config.
# Keep the /32 suffix. IPv4 only -- omit any IPv6 address gluetun
# doesn't need it.
WIREGUARD_ADDRESS=10.x.x.x/32

# Which country gluetun should pick a Mullvad WireGuard server from.
# This is the line mullvad-status --rotate edits automatically -- the
# value here just matters for your very first `docker compose up`.
# Must be a country name Mullvad's server list actually has, e.g.
# "Netherlands", "Germany", "Sweden", "USA", "UK", "Canada".
SERVER_COUNTRIES=Netherlands
