#compdef mullvad-status

_mullvad_status() {
    _arguments \
        '(-h --help)'{-h,--help}'[Show help and exit]' \
        '--monitor[Live dashboard mode, re-checks on an interval]' \
        '--interval=[Set the check interval in seconds for --monitor]:seconds:' \
        '--once[Explicit one-shot check (same as running with no options)]' \
        '--rotate[Rotate to the next country and recreate the tunnel]' \
        '--select[Interactive tiered menu to choose a country or pin a specific exit]' \
        '--heal[Restart the tunnel if it is unhealthy]' \
        '--verbose[Wide one-shot dashboard: all servers, service state, and config files]' \
        '--activate[Enable the mullvad-rotate.timer specifically]' \
        '--disable[Disable the mullvad-rotate.timer specifically]' \
        '--test[Fetch TEST_URL through APP_CONTAINER (or CONTAINER) to confirm real traffic passes]' \
        '--test=[Fetch a specific URL through the app container for this run]:url:' \
        '--service=[Install, disable, or remove the scheduled systemd timers]:action:(install disable remove)'
}

_mullvad_status "$@"
